# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
.env/

# Packaging / build
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Model / embedding artifacts
*.mmap
*.pt
*.npy
*.png
*.svg
*.npz
!**/fixtures/**

# Local research only (not part of the release package)
legacy/
train.log

# Curated example plot output
examples/out/
examples/**/__pycache__/

# Live exploratory run output: deliberately un-ignored so the artifacts stay
# visible in the editor while a run streams. Scratch space -- do not commit.
!runs/
!runs/**

# PDB datasets (outside paper scope; large / regenerable)
examples/data/pdb_*

# LaTeX build products (regenerable from the .tex)
docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc
docs/**/*.pdf
